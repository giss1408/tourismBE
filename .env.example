# Local development. Copy to .env. Staging/production templates are in deploy/.
APP_ENV=development
DEBUG=True
# Empty is fine while DEBUG=True.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default; `docker compose up` uses PostgreSQL instead.
# DATABASE_URL=postgres://tourism:tourism@localhost:5432/tourism

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Social sign-in: when empty, development trusts the app's claims.
FIREBASE_PROJECT_ID=

# Emails are printed to the console while DEBUG=True.
SUPPORT_WHATSAPP=

# Stripe TEST keys to try payments locally (dashboard.stripe.com/test/apikeys),
# and `stripe listen --forward-to localhost:8000/payments/stripe/webhook/`
# for the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Push notifications: path to a Firebase service-account key (optional).
FCM_CREDENTIALS_FILE=
