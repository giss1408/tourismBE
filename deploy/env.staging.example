# Staging configuration. Copy to deploy/production.env on the staging server (git-ignored) and
# fill every value marked CHANGE_ME.
APP_ENV=staging
DEBUG=False
SECRET_KEY=CHANGE_ME   # python -c "import secrets; print(secrets.token_urlsafe(50))"

# Public API host name; Caddy gets its HTTPS certificate for it.
API_DOMAIN=staging-api.akwaba-ivoire.com
ALLOWED_HOSTS=staging-api.akwaba-ivoire.com
CSRF_TRUSTED_ORIGINS=https://staging-api.akwaba-ivoire.com
PUBLIC_BASE_URL=https://staging-api.akwaba-ivoire.com
CORS_ALLOWED_ORIGINS=https://akwaba-ivoire.com
# Caddy is the one proxy in front of gunicorn.
NUM_PROXIES=1

# Database (the db service reads the POSTGRES_* values)
POSTGRES_DB=tourism
POSTGRES_USER=tourism
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://tourism:CHANGE_ME@db:5432/tourism
REDIS_URL=redis://redis:6379/0
BACKUP_RETENTION_DAYS=14

# Operator
COMPANY_NAME=Akwaba Ivoire
SUPPORT_EMAIL=support@akwaba-ivoire.com
SUPPORT_WHATSAPP=CHANGE_ME   # e.g. 2250700000000
BOOKING_SERVICE_FEE_EUR=29
FREE_CANCELLATION_DAYS=7

# Email (SMTP of your provider: Brevo, Mailjet, SES…)
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=Akwaba Ivoire <support@akwaba-ivoire.com>

# Stripe TEST keys (sk_test_…, pk_test_…); webhook endpoint: https://API_DOMAIN/payments/stripe/webhook/
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Firebase: project of the production app, and a service-account key for
# push notifications, placed in deploy/secrets/.
FIREBASE_PROJECT_ID=CHANGE_ME
FCM_CREDENTIALS_FILE=/secrets/firebase-service-account.json

# Error monitoring (sentry.io project DSN)
SENTRY_DSN=
LOG_LEVEL=INFO
